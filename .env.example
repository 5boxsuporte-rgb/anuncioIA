# Copie para .env e preencha. NUNCA commite o arquivo .env.
# Nenhuma destas variáveis é necessária para o MODO DEMO funcionar.

# Banco PostgreSQL (opcional no desenvolvimento: sem isso, usuários ficam em memória)
DATABASE_URL=

# Segredo para assinar a sessão (obrigatório em produção). Gere com: openssl rand -base64 32
AUTH_SECRET=

# Provedor de IA: openai | anthropic | bedrock
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=

# Limite de requisições de análise por IP por minuto (padrão 10)
RATE_LIMIT_PER_MINUTE=
OPENAI_BASE_URL=
